rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // 規則應用於所有檔案
    match /{allPaths=**} {
      // 讀取和寫入: 只允許管理員操作
      // 規則會去 Firestore 檢查使用者是否為管理員
      allow read, write: if request.auth != null && 
                           firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
  }
}